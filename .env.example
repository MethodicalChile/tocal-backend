# Ejecuta 'python scripts/prepare_env.py' para generar los secretos de ambos .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REEMPLAZAR_SECRETO_DJANGO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,tocal.cl,intranet.tocal.cl
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://intranet.tocal.cl
# Conexión desde Supabase > Connect > Session pooler (puerto 5432), SSL obligatorio.
# Cuidado: contraseña con @, %, # o / debe estar codificada como URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REEMPLAZAR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
# Para verify-full, configurar certificado CA compatible y la URL correspondiente.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Usar Settings > API Keys > Secret key (sb_secret_*), solo backend.
SUPABASE_SECRET_KEY=REEMPLAZAR_SB_SECRET_SOLO_BACKEND
# Alternativa temporal de compatibilidad: service_role legado JWT.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tocal-privado
PRIVACY_CONTACT_EMAIL=privacidad@tocal.cl
TRUST_PROXY_HEADERS=1
SESSION_COOKIE_AGE=28800
